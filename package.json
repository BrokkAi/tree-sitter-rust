{
  "name": "tree-sitter-rust",
  "version": "0.24.3",
  "description": "Brokk-maintained Tree-sitter grammar for Rust",
  "type": "module",
  "repository": "https://github.com/BrokkAi/tree-sitter-rust",
  "license": "MIT",
  "author": {
    "name": "Maxim Sokolov",
    "email": "maxim0xff@gmail.com"
  },
  "contributors": [
    {
      "name": "Max Brunsfeld",
      "email": "maxbrunsfeld@gmail.com"
    },
    {
      "name": "Amaan Qureshi",
      "email": "amaanq12@gmail.com"
    }
  ],
  "maintainers": [
    "Brokk"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "rust"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "8.6.0",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "eslint": "9.15.0",
    "eslint-config-treesitter": "1.0.2",
    "prebuildify": "6.0.1",
    "tree-sitter-cli": "0.26.13"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/BrokkAi/tree-sitter-rust/issues"
  },
  "homepage": "https://github.com/BrokkAi/tree-sitter-rust#readme",
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
